# Skopiuj do server/.env i uzupełnij. Nie commituj prawdziwych wartości.
NODE_ENV=production
PORT=8080
DATA_DIR=/data

# Losowy, długi ciąg (np. openssl rand -hex 32). Zmiana unieważnia niewykorzystane kody SMS.
OTP_PEPPER=

# SMS: console (tylko lokalnie) albo smsapi
SMS_PROVIDER=smsapi
SMSAPI_TOKEN=
SMS_SENDER=Lsni

# Sekret do podpisu webhooków dostawcy weryfikacji tożsamości (HMAC-SHA256 w nagłówku X-Signature)
KYC_WEBHOOK_SECRET=

# Numery maskowane: numery platformy (po przecinku) i sekret bramki telefonicznej (nagłówek X-Calls-Secret)
PROXY_NUMBERS=+48 22 000 00 00
CALLS_SECRET=

# Tylko gdy aplikacja jest na innej domenie niż API, np. https://app.lsni.pl
CORS_ORIGINS=

# Tryb demo z symulowanymi wykonawcami (na produkcji: 0)
SIMULATE_PROVIDERS=0
